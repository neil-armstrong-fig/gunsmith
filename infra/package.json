{
  "name": "@gunsmith/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm checks",
    "checks": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "provision": "NODE_OPTIONS=--import=tsx alchemy deploy ./src/Infrastructure.ts --stage prod"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@gunsmith/shared": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
