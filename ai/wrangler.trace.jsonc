{
  // Spike only: tracing flush test against a local fake LangSmith endpoint. The key is a dummy.
  "name": "gunsmith-ai-trace-proof",
  "main": "src/worker/trace/TraceProofWorker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "LANGSMITH_TRACING": "true",
    "LANGSMITH_API_KEY": "dummy-not-a-key",
    "LANGSMITH_ENDPOINT": "http://127.0.0.1:9911",
    "LANGSMITH_PROJECT": "gunsmith-flush-proof",
  },
}
