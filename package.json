{
  "name": "gunsmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "start": "pnpm --filter @gunsmith/webapp start",
    "start:preview": "pnpm --filter @gunsmith/webapp start:preview",
    "api:dev": "pnpm --filter @gunsmith/api start",
    "acceptance-tests": "pnpm --filter @gunsmith/acceptance-tests acceptance-tests",
    "acceptance-tests:preview": "pnpm --filter @gunsmith/webapp compile && PREVIEW_ACCEPTANCE=1 pnpm acceptance-tests",
    "acceptance-tests:preview:local": "PREVIEW_API_MODE=local pnpm acceptance-tests:preview",
    "acceptance-tests:preview:api": "PREVIEW_API_MODE=external pnpm acceptance-tests:preview",
    "install-browsers": "pnpm --filter @gunsmith/acceptance-tests install-browsers",
    "build": "pnpm --recursive build",
    "deploy:fromLocal": "pnpm --filter @gunsmith/webapp compile && printf '/*\\n  X-Robots-Tag: noindex\\n' | diff -u - webapp/build/_headers && printf '{\"commit\":\"%s\"}\\n' \"$(git rev-parse HEAD)\" > webapp/build/release.json && SITE_ORIGIN=https://gunsmith.neilarmstrong.dev pnpm --filter @gunsmith/infra provision --env-file ../.env.local && pnpm --filter @gunsmith/infra exec wrangler deploy --config ../webapp/wrangler.jsonc --env-file ../.env.local",
    "checks": "pnpm checks:repository && pnpm --recursive checks",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "pnpm --recursive format",
    "format:check": "pnpm --recursive format:check",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --recursive test",
    "checks:repository": "pnpm --filter @gunsmith/shared exec node config/repository/CheckRepository.ts",
    "test:properties": "pnpm --no-sort --no-bail --filter @gunsmith/engine --filter @gunsmith/webapp --filter @gunsmith/api test:properties",
    "evals": "EVAL_GATE=all EVAL_SUITE=all EVAL_TRIALS=1 EVAL_TRACK=0 pnpm --filter @gunsmith/ai evals:fake"
  }
}
